{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",

    "allowJs": true,                  
    "checkJs": false,
    "noEmit": true,                   
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "lib": ["ESNext", "DOM"],
    "types": ["vitest/globals", "vite/client", "@testing-library/jest-dom", "node"]
  },
  "include": ["src", "vite.config.*"]
}